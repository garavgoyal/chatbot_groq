# Copy this file to .env and fill in real values. .env is gitignored.

GROQ_API_KEY=

# Optional — leave unset to run with in-memory storage (no persistence,
# resets on restart) instead of Supabase.
SUPABASE_URL=
SUPABASE_KEY=

# Optional — comma-separated list of origins allowed to call this API.
# Defaults to http://localhost:5173 (the Vite dev server) if unset.
ALLOWED_ORIGINS=http://localhost:5173
